    {
      "name": "2. Real-time Notification Engine",
      "item": [
        {
          "name": "08 - Get Initial Watermark & History (No last_id)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/crm/realtime-check",
              "host": ["{{base_url}}"],
              "path": ["crm", "realtime-check"]
            },
            "description": "Returns latest_id watermark and initial recent history without playing sounds."
          }
        },
        {
          "name": "09 - Poll for New Incoming Leads (with last_id)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/crm/realtime-check?last_id={{last_id}}",
              "host": ["{{base_url}}"],
              "path": ["crm", "realtime-check"],
              "query": [
                { "key": "last_id", "value": "{{last_id}}" }
              ]
            },
            "description": "Polls for new leads since last_id. When new leads arrive, the client triggers the audio chime and push notification."
          }
        }
      ]
    },
