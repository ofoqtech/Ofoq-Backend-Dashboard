        "/api/service-form": {
            "post": {
                "tags": [
                    "Public API & Services"
                ],
                "summary": "Submit Service Inquiry Form (Creates CRM Lead)",
                "description": "Public contact and quote request form. Creates a new Lead and logs attribution metadata. Accepts mobile or phone.",
                "operationId": "adb593405a0847c24d136b791a4a8f41",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "mobile",
                                    "service_id"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Sherif Watany"
                                    },
                                    "mobile": {
                                        "description": "Contact mobile or phone number",
                                        "type": "string",
                                        "example": "01012345678"
                                    },
                                    "phone": {
                                        "description": "Alias for mobile",
                                        "type": "string",
                                        "example": "01012345678",
                                        "nullable": true
                                    },
                                    "service_id": {
                                        "description": "ID of requested Service or Budget tier",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "client@example.com",
                                        "nullable": true
                                    },
                                    "company": {
                                        "type": "string",
                                        "example": "Acme Corp",
                                        "nullable": true
                                    },
                                    "message": {
                                        "type": "string",
                                        "example": "Need web and mobile app integration.",
                                        "nullable": true
                                    },
                                    "utm_source": {
                                        "type": "string",
                                        "example": "meta",
                                        "nullable": true
                                    },
                                    "utm_medium": {
                                        "type": "string",
                                        "example": "paid_social",
                                        "nullable": true
                                    },
                                    "utm_campaign": {
                                        "type": "string",
                                        "example": "Ramadan_Promo_2026",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inquiry received and Lead created"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "429": {
                        "description": "Rate limit exceeded"
                    }
                }
            }
        },
