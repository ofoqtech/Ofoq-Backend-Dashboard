                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "initial_message": {
                                        "type": "string",
                                        "example": "Hello from Ofoq Technology!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Conversation started successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
