                "summary": "Send Outgoing WhatsApp Text Message",
                "description": "Sends an official WhatsApp text message directly via Meta WhatsApp Cloud API.",
                "operationId": "087624dcf2c4c6c33d7e23c2f34116fd",
                "parameters": [
                    {
                        "name": "conversation",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "message"
                                ],
                                "properties": {
                                    "message": {
                                        "type": "string",
                                        "example": "Hello! Thanks for reaching out. How can we help?"
                                    },
                                    "reply_to_message_id": {
                                        "type": "string",
                                        "example": "wamid.HBg...",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Message sent successfully"
