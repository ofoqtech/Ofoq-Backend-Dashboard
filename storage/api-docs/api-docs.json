{
    "openapi": "3.0.0",
    "info": {
        "title": "Ofoq Technology CRM & WhatsApp API",
        "description": "Ofoq Technology CRM, WhatsApp Business Cloud API & Portfolio REST API Documentation. Use this interactive Swagger UI to inspect, execute, and test any API endpoint.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Development Server (Port 8000)"
        },
        {
            "url": "/",
            "description": "Current Environment Server"
        }
    ],
    "paths": {
        "/webhooks/whatsapp": {
            "get": {
                "tags": [
                    "WhatsApp Cloud API"
                ],
                "summary": "Meta WhatsApp Webhook Handshake Verification (GET)",
                "description": "Endpoint invoked by Meta to verify webhook URL with hub.mode, hub.verify_token, and hub.challenge.",
                "operationId": "a393adec8367deb5e904ac7bf8bed113",
                "parameters": [
                    {
                        "name": "hub_mode",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "default": "subscribe"
                        }
                    },
                    {
                        "name": "hub_verify_token",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "default": "ofoq_whatsapp_verify_token_2026"
                        }
                    },
                    {
                        "name": "hub_challenge",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "default": "123456789"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Webhook verified, returns challenge string"
                    },
                    "403": {
                        "description": "Invalid verification token"
                    }
                }
            },
            "post": {
                "tags": [
                    "WhatsApp Cloud API"
                ],
                "summary": "Meta WhatsApp Incoming Webhook Events (POST)",
                "description": "Receives real-time incoming messages, media events, and status updates (sent, delivered, read, failed) from Meta.",
                "operationId": "f5641a689db0e5e10de2df7511e58224",
                "parameters": [
                    {
                        "name": "X-Hub-Signature-256",
                        "in": "header",
                        "description": "HMAC-SHA256 signature calculated with Meta App Secret",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {},
                            "example": {
                                "object": "whatsapp_business_account",
                                "entry": [
                                    {
                                        "id": "WABA_ACCOUNT_ID",
                                        "changes": [
                                            {
                                                "value": {
                                                    "messaging_product": "whatsapp",
                                                    "metadata": {
                                                        "display_phone_number": "+20 100 000 0000",
                                                        "phone_number_id": "100000000000000"
                                                    },
                                                    "contacts": [
                                                        {
                                                            "profile": {
                                                                "name": "Ahmed Client"
                                                            },
                                                            "wa_id": "201012345678"
                                                        }
                                                    ],
                                                    "messages": [
                                                        {
                                                            "from": "201012345678",
                                                            "id": "wamid.HBgSAMPLE12345",
                                                            "timestamp": "1731067200",
                                                            "text": {
                                                                "body": "Hello, I want to inquire about mobile app development."
                                                            },
                                                            "type": "text"
                                                        }
                                                    ]
                                                },
                                                "field": "messages"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Event queued and acknowledged",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "status": "received"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Signature verification failed"
                    }
                }
            }
        },
        "/crm/whatsapp/conversations": {
            "post": {
                "tags": [
                    "WhatsApp Cloud API"
                ],
                "summary": "Start a new WhatsApp Conversation",
